# Copy into the app's Settings -> Secrets on share.streamlit.io (never commit real values). All optional.
# Makes API mode work without asking each user for a key:
# ANTHROPIC_API_KEY = "sk-ant-..."
# Password gate in front of the app:
# APP_PASSWORD = "choose-a-team-password"
# Google Drive folder browser (service-account JSON key, pasted whole):
# GOOGLE_SERVICE_ACCOUNT_JSON = '''
# { "type": "service_account", ... }
# '''
